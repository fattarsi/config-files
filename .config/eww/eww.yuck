;; ─────────────────────────────────────────────────────────────────
;; eww bar config — replaces waybar; gives per-workspace + per-column
;; click and smooth cairo graphs.
;; ─────────────────────────────────────────────────────────────────

;; Listen to niri-eww-state.sh which emits a JSON array of workspaces,
;; each with its columns + per-app/per-window color resolved.
;; Drawer state: collapsed by default.
(defvar tray_open false)
(defvar graphs_open false)
(defvar volbat_open false)

(deflisten niri_state :initial "[]"
  "/home/fattarsi/.local/bin/niri-eww-state.sh")

;; Focused window title (re-queries on every niri Window event)
(deflisten focused_title :initial ""
  "niri msg event-stream 2>/dev/null | while IFS= read -r l; do case \"$l\" in *Window*) niri msg --json focused-window 2>/dev/null | jq -r '.title // \"\"' ;; esac; done")

;; Volume updates instantly via pactl subscribe (no 2s poll lag).
(deflisten volume :initial "0"
  "/home/fattarsi/.local/bin/niri-eww-volume.sh")

;; SVG-based history graphs — each poll generates an SVG and emits its path.
;; The path changes per tick so eww's image widget reloads.
(defpoll cpu_svg :interval "1s" :initial "" "/home/fattarsi/.local/bin/niri-graph-svg.py cpu")
(defpoll mem_svg :interval "1s" :initial "" "/home/fattarsi/.local/bin/niri-graph-svg.py mem")
(defpoll net_svg :interval "1s" :initial "" "/home/fattarsi/.local/bin/niri-graph-svg.py net")

;; ─────────────────────────────────────────────────────────────────
;; Widgets
;; ─────────────────────────────────────────────────────────────────

(defwidget minimap []
  (eventbox
    :onscroll "if [ {} = up ]; then niri msg action focus-column-left; else niri msg action focus-column-right; fi"
    (box :class "minimap" :orientation "h" :spacing 14 :space-evenly false :halign "start"
      (for ws in niri_state
        (workspace_view :ws ws)))))

(defwidget workspace_view [ws]
  (box :class "ws-block" :orientation "h" :spacing 2 :space-evenly false
    (button :class {ws.is_focused
                      ? (ws.has_urgent ? "ws-label focused urgent" : "ws-label focused")
                      : (ws.has_urgent ? "ws-label urgent" : "ws-label")}
            :onclick "niri msg action focus-workspace ${ws.idx}"
            (label :text {ws.name != "" ? ws.name : "${ws.idx}"}))
    (for col in {ws.columns}
      (button :class {col.is_urgent
                        ? "col-box urgent"
                        : (ws.is_focused && col.is_focused_col ? "col-box focused-col" : "col-box")}
              :style "color: ${col.color};"
              :onclick "niri msg action focus-window --id ${col.primary_window_id}"
              (label :text {col.stack_size > 1 ? "▣" : "■"})))))

(defwidget left_section []
  (box :orientation "h" :halign "start" :space-evenly false
    (minimap)))

(defwidget center_section []
  (box :orientation "h" :halign "center" :space-evenly false
    (label :class "title" :text focused_title :limit-width 80)))

(defwidget right_section []
  (box :orientation "h" :halign "end" :space-evenly false :spacing 8
    (graphs_drawer)
    (tray_drawer)
    (volbat_drawer)
    (button :class "clock"
            :onclick "eww open --toggle calendar"
            (label :text {formattime(EWW_TIME, "%a %b %d  %H:%M")}))))

(defwidget graphs_drawer []
  (box :class "graphs-drawer" :orientation "h" :space-evenly false :spacing 0
    (button :class "graphs-toggle"
            :onclick "eww update graphs_open=${!graphs_open}"
            (label :text {graphs_open ? "›" : "‹"}))
    (revealer :transition "slideleft" :reveal graphs_open :duration "200ms"
      (box :orientation "h" :spacing 4
        (image :class "graph-img cpu" :path cpu_svg :image-width 77 :image-height 36)
        (image :class "graph-img mem" :path mem_svg :image-width 77 :image-height 36)
        (image :class "graph-img net" :path net_svg :image-width 77 :image-height 36)))))

(defwidget tray_drawer []
  (box :class "tray-drawer" :orientation "h" :space-evenly false :spacing 0
    (button :class "tray-toggle"
            :onclick "eww update tray_open=${!tray_open}"
            (label :text {tray_open ? "›" : "‹"}))
    (revealer :transition "slideleft" :reveal tray_open :duration "200ms"
      (systray :class "tray" :icon-size 16 :spacing 6 :space-evenly false))))

(defwidget vol_bat []
  (box :class "volbat" :orientation "h" :space-evenly false :spacing 0
    (label :class "stat vol" :text "🔊 ${volume}%")
    (label :class "stat bat"
           :text {EWW_BATTERY.BAT0.status == "Charging"
                    ? "⚡ ${EWW_BATTERY.BAT0.capacity}%"
                    : EWW_BATTERY.BAT0.capacity < 20
                      ? "🪫 ${EWW_BATTERY.BAT0.capacity}%"
                      : "🔋 ${EWW_BATTERY.BAT0.capacity}%"})))

(defwidget volbat_drawer []
  (box :class "volbat-drawer" :orientation "h" :space-evenly false :spacing 0
    (button :class "volbat-toggle"
            :onclick "eww update volbat_open=${!volbat_open}"
            (label :text {volbat_open ? "›" : "‹"}))
    (revealer :transition "slideleft" :reveal volbat_open :duration "200ms"
      (vol_bat))))

(defwidget bar []
  (centerbox :orientation "h"
    (left_section)
    (center_section)
    (right_section)))

;; ─────────────────────────────────────────────────────────────────
;; Window
;; ─────────────────────────────────────────────────────────────────

(defwindow bar
  :monitor 0
  :exclusive true
  :stacking "fg"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "40px" :anchor "top center")
  (bar))

;; Popup calendar — opened/closed by clicking the clock label.
(defwindow calendar
  :monitor 0
  :stacking "fg"
  :geometry (geometry :x "0" :y "32px" :width "300px" :height "260px" :anchor "top right")
  (box :class "calendar-box" :orientation "v"
    (calendar :class "calendar")))
