# kanshi — wayland equivalent of your awesome .xprofile xrandr logic.
# Picks the FIRST profile whose outputs all match. So put the more-specific
# (docked) profile first.
#
# Output names below assume the niri convention. Verify with:
#   niri msg outputs
# and edit if the connector names differ on your system.

profile docked {
    output eDP-1 disable
    output "HDMI-A-1" enable mode 3840x2160 position 0,0 scale 2
}

profile mobile {
    output eDP-1 enable mode 2560x1600 position 0,0 scale 1
}
