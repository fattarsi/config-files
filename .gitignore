# Ignore everything by default
/*

# Shell configs
!.bashrc
!.zshrc
!.vimrc
!.gitconfig
!.gitignore

# One-off install scripts kept in $HOME for re-running on fresh machines
!install-niri-nvidia-workaround.sh
!install-waybar-build-deps.sh

# Terminator
!.config
.config/*
!.config/terminator
.config/terminator/*
!.config/terminator/config

# XDG user dirs
!.config/user-dirs.dirs

# XFCE4
!.config/xfce4
.config/xfce4/*
!.config/xfce4/xfconf
.config/xfce4/xfconf/*
!.config/xfce4/xfconf/xfce-perchannel-xml
.config/xfce4/xfconf/xfce-perchannel-xml/*
!.config/xfce4/xfconf/xfce-perchannel-xml/keyboard-layout.xml
!.config/xfce4/xfconf/xfce-perchannel-xml/keyboards.xml
!.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml
!.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml

# Kitty
!.config/kitty
.config/kitty/*
!.config/kitty/kitty.conf

# Awesome WM
!.config/awesome
.config/awesome/*
!.config/awesome/rc.lua
!.config/awesome/battery.lua
!.config/awesome/sysmon.lua
!.config/awesome/calendar.lua
!.config/awesome/locker.sh
!.config/awesome/.xprofile
!.config/awesome/.Xresources
!.config/awesome/claude-notify.lua
!.config/awesome/claude-notify-listener.py
!.config/awesome/double-tap-home.sh
!.config/awesome/workspace-launcher.sh

# Bin scripts
!bin
bin/*
!bin/volume-hotkeys.sh
!bin/speech_to_text.sh
!bin/external-only.sh

# Niri helper scripts (referenced by config.kdl keybinds and spawn-at-startup)
!.local
.local/*
!.local/bin
.local/bin/*
!.local/bin/niri-color-cycle.sh
!.local/bin/niri-color-pick.sh
!.local/bin/niri-rename-workspace.sh
!.local/bin/niri-restore-workspace-names.sh
!.local/bin/niri-import-workspace-names.sh
!.local/bin/niri-jump-urgent.sh
!.local/bin/niri-overview-zoom.sh
!.local/bin/niri-overview-opacity.sh
!.local/bin/niri-claude-notify-listener.py
!.local/bin/niri-eww-state.sh
!.local/bin/niri-eww-volume.sh
!.local/bin/niri-graph-svg.py
!.local/bin/niri-graph-tooltip.sh
!.local/bin/niri-btop-toggle.sh
!.local/bin/niri-focus-column-n.sh
!.local/bin/niri-focus-column-or-ws.sh
!.local/bin/niri-new-workspace.sh
!.local/bin/niri-terminal-cwd.sh

# Eww (status bar — replaces waybar)
!.config/eww
.config/eww/*
!.config/eww/eww.yuck
!.config/eww/eww.scss

# Kanshi (wayland xrandr equivalent — auto-applies monitor profiles)
!.config/kanshi
.config/kanshi/*
!.config/kanshi/config

# Mako (wayland notification daemon)
!.config/mako
.config/mako/*
!.config/mako/config

# systemd user drop-in for niri.service
!.config/systemd
.config/systemd/*
!.config/systemd/user
.config/systemd/user/*
!.config/systemd/user/niri.service.d
!.config/systemd/user/niri.service.d/*

# Niri (wayland WM)
!.config/niri
.config/niri/*
!.config/niri/config.kdl
!.config/niri/app-colors.conf
